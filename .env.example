NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM Router ──────────────────────────────────────────────
# router = Gemini (extracción) + Anthropic (chat) + Ollama (fallback)
# ollama = solo local (lento, desarrollo offline)
LEGAL_LLM_ENABLED=true
LEGAL_LLM_PROVIDER=router

# Extracción estructurada (PDF → JSON)
LEGAL_LLM_EXTRACT_PROVIDER=gemini
LEGAL_LLM_EXTRACT_MODEL=gemini-3.6-flash

# Chat decisión + redacción Word
LEGAL_LLM_CHAT_PROVIDER=anthropic
LEGAL_LLM_CHAT_MODEL=claude-sonnet-4-20250514

# Reintento JSON estricto (opcional)
LEGAL_LLM_JSON_PROVIDER=openai
LEGAL_LLM_JSON_MODEL=gpt-4o-mini

# Fallback offline (solo desarrollo local; en Vercel dejar en false)
LEGAL_LLM_ALLOW_OLLAMA_FALLBACK=false
LEGAL_LLM_FALLBACK_PROVIDER=ollama
LEGAL_LLM_ENDPOINT=http://127.0.0.1:11434/api/generate
LEGAL_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# API keys (producción)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Timeouts y límites
LEGAL_LLM_TIMEOUT_MS=60000
LEGAL_LLM_USE_JSON_FORMAT=true
LEGAL_LLM_JSON_RETRIES=1
LEGAL_LLM_MAX_CONTEXT_CHARS=900000

# Parsing de expediente
LEGAL_PDF_PARSE_CONCURRENCY=3
LEGAL_MAX_DOCS_FOR_LLM=12
